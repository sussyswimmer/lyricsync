  "merge": [
    {
      "why": "a partial object changes only its keys, stored in the canonical spelling",
      "current": {
        "enabled": true,
        "toggleLyrics": "CmdOrCtrl+Alt+Shift+L",
        "nudgeEarlier": "CmdOrCtrl+Alt+Shift+]",
        "nudgeLater": "CmdOrCtrl+Alt+Shift+["
      },
      "patch": {
        "toggleLyrics": "ctrl+alt+k"
      },
      "expected": {
        "enabled": true,
        "toggleLyrics": "Control+Alt+K",
        "nudgeEarlier": "CmdOrCtrl+Alt+Shift+]",
        "nudgeLater": "CmdOrCtrl+Alt+Shift+["
      }
    },
    {
      "why": "the switch alone",
      "current": {
        "enabled": true,
        "toggleLyrics": "CmdOrCtrl+Alt+Shift+L",
        "nudgeEarlier": "CmdOrCtrl+Alt+Shift+]",
        "nudgeLater": "CmdOrCtrl+Alt+Shift+["
      },
      "patch": {
        "enabled": false
      },
      "expected": {
        "enabled": false,
        "toggleLyrics": "CmdOrCtrl+Alt+Shift+L",
        "nudgeEarlier": "CmdOrCtrl+Alt+Shift+]",
        "nudgeLater": "CmdOrCtrl+Alt+Shift+["
      }
    },
    {
