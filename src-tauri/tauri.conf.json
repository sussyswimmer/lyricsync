{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Undertone",
  "version": "0.1.0",
  "identifier": "com.undertone.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "overlay",
        "title": "Undertone",
        "url": "index.html",
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Undertone Settings",
        "url": "settings.html",
        "width": 380,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "publisher": "Undertone",
    "homepage": "https://github.com/sussyswimmer/lyricsync",
    "category": "Music",
    "shortDescription": "Synced lyrics on your desktop",
    "longDescription": "Undertone shows the synced lyrics of the song you're playing on your desktop, between the wallpaper and your icons.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-",
      "hardenedRuntime": false
    }
  }
}
